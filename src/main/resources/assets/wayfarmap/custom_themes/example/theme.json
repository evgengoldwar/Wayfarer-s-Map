// Пример своей темы Wayfarer's Map: здесь перечислено ВСЁ, что тема может поменять.
// Example custom theme of Wayfarer's Map: EVERY key a theme can set is listed here.
//
// Тема = папка в .minecraft/wayfarmap/CustomThemes. Имя папки — имя темы в настройках файла.
// Рядом лежит atlas.png — атлас картинок. Поменяйте и сохраните файл: тема перечитается сама,
// если окно мода открыто. Ещё она перечитывается, когда её выбирают в настройках, и по F3+T.
// Полное описание: ../README.md. Ошибки пишутся в ../errors.txt.
//
// Комментарии // и /* */ разрешены. Запятая после последнего элемента — нельзя.
// Любой ключ можно удалить: тогда берётся значение из темы "extends".
{
  // Название в настройках: строка или по языкам (en_US, ru_RU, uk_UA, zh_CN).
  "name": { "en_US": "Copper (example)", "ru_RU": "Медь (пример)", "uk_UA": "Мідь (приклад)", "zh_CN": "铜（示例）" },

  // Из какой темы взять всё, что здесь не указано: graphite, forest, nether, ocean, end, desert, snow,
  // vanilla или имя другой своей темы. Если тема называется как встроенная (папка "nether"), она её заменяет.
  "extends": "graphite",

  // Светлая тема (тёмный текст на светлом). Влияет на цвета, которые вычисляются сами.
  "light": false,
  // Объёмные края у панелей и кнопок, как в ванильном Minecraft (для частей без картинок).
  "bevel": false,
  // Тень у заголовков окон. По умолчанию есть на тёмных темах и нет на светлых.
  "titleShadow": true,

  // Полоса под заголовком окна: цвета по очереди, каждый длиной "run" пикселей; "flows": бежит, как лава.
  // null — без полосы. Картинка "decor" из атласа (ниже), если есть, рисуется вместо неё.
  "decor": { "run": 4, "flows": false, "colors": ["#FFD9A441", "#FFC8783A", "#FF8A4E24", "#FFC8783A"] },

  // Цвета: "#RRGGBB" (непрозрачный), "#AARRGGBB" (AA — прозрачность, 00..FF) или "#RGB".
  "colors": {
    // --- Основные. Если задан хоть один, остальные (ниже) вычисляются из них заново,
    //     кроме тех, что тоже заданы в этом файле. ---
    "screenDim": "#C0080605",    // затемнение всего, что за окном мода
    "panel": "#F01E1A17",        // фон окна
    "panelAlt": "#F02A211B",     // второй фон окна (полосы, заголовки)
    "border": "#FF4A3A2C",       // рамки
    "control": "#FF3A2E24",      // кнопки и элементы управления
    "controlHover": "#FF4A3A2C", // элемент под мышью
    "controlDisabled": "#FF2A2724", // выключенный элемент
    "accent": "#FFD9A441",       // акцент: выбранное, активное, линии
    "accentDim": "#FF8A4E24",    // приглушённый акцент: фон выбранной кнопки
    "danger": "#FFE05A4A",       // опасное действие (удалить)
    "success": "#FF7CC46A",      // успех
    "text": "#FFF0E2CC",         // основной текст
    "textMuted": "#FFA8957C",    // второстепенный текст
    "textDisabled": "#FF6A5C4C", // текст выключенного
    "labelBg": "#C0100C0A",      // фон подписей на карте

    // --- Производные: без них вычисляются из основных. ---
    "header": "#F02A211B",       // фон заголовка окна
    "field": "#FF0E0B09",        // поле ввода
    "fieldText": "#FFF0E2CC",    // текст в поле ввода
    "buttonText": "#FFF0E2CC",   // текст на кнопках
    "textBright": "#FFFFFFFF",   // яркий текст (заголовок под мышью)
    "textSoft": "#FFD0BCA0",     // текст между text и textMuted
    "accentSoft": "#FFF0D08A",   // светлый оттенок акцента
    "deep": "#FF120E0B",         // углубление: списки, картинки, превью
    "card": "#FF2C241E",         // карточка списка
    "cardHover": "#FF3A2E24",    // карточка под мышью
    "cardHeader": "#FF342A22",   // шапка карточки
    "cardSelected": "#FF4A3220", // выбранная карточка
    "cardSelectedHover": "#FF5A3C24", // выбранная карточка под мышью
    "sidebar": "#FF191512",      // боковая колонка окна
    "section": "#FF1E1A17",      // полоса названия раздела
    "chosen": "#FF4A3220",       // выбранная карточка (язык, раскладка, тема)
    "dangerDim": "#FF3A1C18",    // мягкий фон опасного
    "dangerDimHover": "#FF4A221C", // мягкий фон опасного под мышью
    "dangerStrong": "#FF6A2A22", // сильный фон опасного (включено)
    "dangerStrongHover": "#FF8A3228", // сильный фон опасного под мышью
    "rowHover": "#20FFFFFF",     // подсветка строки под мышью
    "tooltipText": "#FFF0E2CC"   // текст подсказок
  },

  // Атлас картинок рядом с этим файлом (PNG любого размера). Без "atlas" тема берёт картинки темы "extends".
  "atlas": "atlas.png",

  // Картинки частей интерфейса. Часть без картинки (или с null) рисуется цветами темы.
  // Ключи картинки:
  //   "uv": [x, y, ширина, высота] — прямоугольник в атласе (в пикселях атласа)            — обязательно
  //   "border": 4 или [лево, верх, право, низ] — края, которые не растягиваются (9-slice)  — 0
  //   "scale": 1 — пикселей GUI на пиксель атласа (0.5 — атлас в 2 раза детальнее)          — 1
  //   "tile": false — середину и края повторять, а не растягивать                           — false
  //   "center": true — рисовать середину (false — только рамка)                            — true
  //   "tint": "#FFFFFFFF" — умножить картинку на цвет (и прозрачность)                       — белый
  //   "recolor": false — красить картинку цветом детали (иконки: под тему и состояние)     — true у icon.*
  //   "frames": 1, "frameTime": 100 — анимация: кадры друг под другом, мс на кадр             — 1
  //   "width"/"height": свой размер у тонких частей (скроллбар, ползунок, полоса)            — как у части
  // Состояния ищутся по порядку: "button.active.hover" → "button.active" → "button".
  "sprites": {

    // --- Окна ---
    "screen": {"uv": [132, 0, 16, 16], "tile": true},  // затемнение за окном (на весь экран)
    "panel": {"uv": [0, 0, 24, 24], "border": 6},  // фон окна
    "header": {"uv": [24, 0, 24, 24], "border": [4, 4, 4, 3]},  // заголовок окна (30 px высотой)
    "header.accent": {"uv": [148, 4, 8, 1]},  // линия под названием окна (1 px)
    "decor": {"uv": [148, 0, 16, 2]},  // полоса под заголовком, повторяется по ширине
    "pill": {"uv": [104, 0, 12, 12], "border": 3},  // плашка справа в заголовке (счётчик, размер)
    "tooltip": {"uv": [48, 0, 16, 16], "border": 4},  // подсказка (и подсказки Minecraft в окнах мода)
    "dropdown": {"uv": [64, 0, 16, 16], "border": 4},  // открытый список под кнопкой
    "toast": {"uv": [80, 0, 16, 16], "border": 4},  // всплывающее сообщение внизу
    "label": {"uv": [96, 0, 8, 8], "border": 2},  // подписи на карте
    "drag": {"uv": [116, 0, 16, 16], "border": 4},  // путевая точка, которую тащат мышью

    // --- Кнопки (у каждой: обычная, .hover под мышью, .active включённая, .active.hover, .disabled, .danger красная) ---
    "button": {"uv": [0, 32, 20, 16], "border": 4},
    "button.hover": {"uv": [20, 32, 20, 16], "border": 4},
    "button.active": {"uv": [40, 32, 20, 16], "border": 4},
    "button.active.hover": {"uv": [60, 32, 20, 16], "border": 4},
    "button.disabled": {"uv": [80, 32, 20, 16], "border": 4},
    "button.danger": {"uv": [100, 32, 20, 16], "border": 4},
    "button.danger.hover": {"uv": [120, 32, 20, 16], "border": 4},

    // --- Кнопки-иконки (панели карты). Без них берутся картинки button.* ---
    "icon_button": {"uv": [0, 48, 20, 16], "border": 4},
    "icon_button.hover": {"uv": [20, 48, 20, 16], "border": 4},
    "icon_button.active": {"uv": [40, 48, 20, 16], "border": 4},
    "icon_button.active.hover": {"uv": [60, 48, 20, 16], "border": 4},
    "icon_button.disabled": {"uv": [80, 48, 20, 16], "border": 4},

    // --- Поля ввода ---
    "field": {"uv": [0, 64, 16, 16], "border": 3},  // поле
    "field.focused": {"uv": [16, 64, 16, 16], "border": 3},  // поле, в котором печатают
    "value": {"uv": [32, 64, 16, 16], "border": 3},  // число слева от ползунка (без него — field)
    "value.hover": {"uv": [48, 64, 16, 16], "border": 3},

    // --- Настройки ---
    "switch.off": {"uv": [16, 80, 24, 12], "border": 5},  // переключатель выкл. (24x12)
    "switch.off.hover": {"uv": [40, 80, 24, 12], "border": 5},
    "switch.on": {"uv": [64, 80, 24, 12], "border": 5},  // переключатель вкл.
    "switch.on.hover": {"uv": [88, 80, 24, 12], "border": 5},
    "switch.knob": {"uv": [112, 80, 8, 8], "border": 2},  // ручка переключателя (8x8)
    "segment": {"uv": [0, 96, 16, 16], "border": 3},  // кнопка списка значений, где все видны сразу
    "segment.hover": {"uv": [16, 96, 16, 16], "border": 3},
    "segment.selected": {"uv": [32, 96, 16, 16], "border": 3},  // выбранное значение
    "segment.selected.hover": {"uv": [48, 96, 16, 16], "border": 3},
    "selector": {"uv": [64, 64, 20, 16], "border": 4},  // список с одним значением и стрелками < >
    "selector.hover": {"uv": [84, 64, 20, 16], "border": 4},
    "slider.track": {"uv": [64, 96, 12, 4], "border": 2, "height": 4},  // дорожка ползунка
    "slider.fill": {"uv": [76, 96, 12, 4], "border": 2, "height": 4},  // заполненная часть дорожки
    "slider.fill.hover": {"uv": [88, 96, 12, 4], "border": 2, "height": 4},
    "slider.knob": {"uv": [100, 96, 6, 12], "border": 2, "width": 6},  // ручка ползунка
    "slider.knob.hover": {"uv": [106, 96, 6, 12], "border": 2, "width": 6},

    // --- Полоса прокрутки ---
    "scrollbar.track": {"uv": [0, 80, 4, 12], "border": 2, "width": 4},  // дорожка
    "scrollbar.thumb": {"uv": [4, 80, 4, 12], "border": 2, "width": 4},  // бегунок
    "scrollbar.thumb.hover": {"uv": [8, 80, 4, 12], "border": 2, "width": 4},  // бегунок под мышью

    // --- Миникарта (рамка включается в настройках миникарты) ---
    "minimap.frame": {"uv": [0, 112, 16, 16], "border": 5, "center": false},  // рамка квадратной миникарты
    "minimap.frame.round": {"uv": [192, 0, 64, 64]},  // рамка круглой миникарты: картинка кольца

    // --- Иконки: icon.<имя>. Все имена и шаблон — в ../_icons (icons.json, icons.png) ---
    "icon.close": {"uv": [0, 128, 9, 8]},  // крестик закрытия окна
    "icon.settings": {"uv": [12, 128, 11, 11]}  // шестерёнка
  }
}
